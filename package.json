{
  "name": "blockchain-secp-falcon",
  "version": "2.0.0",
  "description": "Educational Layer 1 blockchain in Node.js — pluggable consensus (PoW/PoS), pluggable crypto (secp256k1/Falcon-512 PQC), Hyperswarm P2P, mempool, block rewards, difficulty adjustment, RocksDB persistence, REST API, and CLI.",
  "main": "src/index.js",
  "bin": {
    "blockchain": "bin/cli.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:pow": "CONSENSUS_MODE=pow node src/index.js",
    "start:pos": "CONSENSUS_MODE=pos node src/index.js",
    "start:secp": "CRYPTO_MODE=secp256k1 node src/index.js",
    "start:falcon": "CRYPTO_MODE=falcon node src/index.js",
    "test": "jest --runInBand --verbose",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ac12644/blockchain-secp-falcon"
  },
  "keywords": [
    "blockchain",
    "cryptocurrency",
    "nodejs",
    "secp256k1",
    "falcon",
    "post-quantum",
    "pqc",
    "proof-of-work",
    "proof-of-stake",
    "p2p",
    "hyperswarm",
    "merkle-tree",
    "mempool",
    "rocksdb",
    "educational"
  ],
  "author": "Abhishek Chauhan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ac12644/blockchain-secp-falcon/issues"
  },
  "homepage": "https://github.com/ac12644/blockchain-secp-falcon",
  "dependencies": {
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "hyperswarm": "^4.17.0",
    "rocksdb": "^5.2.1",
    "undici": "^8.0.2"
  },
  "optionalDependencies": {
    "pqclean": "^0.8.1"
  },
  "devDependencies": {
    "jest": "^30.3.0"
  }
}
